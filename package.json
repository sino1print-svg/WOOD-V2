{
  "name": "mockup-photoshoot-director",
  "version": "0.1.0",
  "private": true,
  "description": "Mockup Photoshoot Director — Phase 7 deterministic Cover Engine with approved Phase 0–6 foundations.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:determinism": "node scripts/build-determinism.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "verify:full": "npm run audit:full && npm run audit:prod && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run verify:determinism && npm run build",
    "audit:full": "node scripts/npm-audit-retry.mjs full",
    "audit:prod": "node scripts/npm-audit-retry.mjs prod",
    "hash:source-tree": "node scripts/source-tree-hash.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "5.0.4",
    "ajv-formats": "3.0.1",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
